import csv
import matplotlib.pyplot as plt

# En tom liste for hver måned
vind_per_maaned = {}
for maaned in range(1, 13):
    vind_per_maaned[maaned] = []

filnavn = "oslo_blindern_1954_2025_med_makstemperatur.csv"

with open(filnavn, encoding="utf-8-sig") as fil:
    leser = csv.reader(fil, delimiter=";")
    next(leser)  # Hopper over overskriften

    for rad in leser:
        if len(rad) < 7:
            continue

        try:
            # Datoen har formatet dd.mm.åååå
            maaned = int(rad[2].split(".")[1])

            # Kolonne 6 inneholder høyeste middelvind i døgnet
            vind = float(rad[6].replace(",", "."))
        except (ValueError, IndexError):
            continue  # Hopper over manglende data og slutteksten

        vind_per_maaned[maaned].append(vind)

minimum = []
median = []
maksimum = []

for maaned in range(1, 13):
    verdier = sorted(vind_per_maaned[maaned])
    antall = len(verdier)

    if antall == 0:
        minimum.append(float("nan"))
        median.append(float("nan"))
        maksimum.append(float("nan"))
        continue

    minimum.append(verdier[0])
    maksimum.append(verdier[-1])

    midten = antall // 2

    if antall % 2 == 1:
        median.append(verdier[midten])
    else:
        median.append(
            (verdier[midten - 1] + verdier[midten]) / 2
        )

maaneder = list(range(1, 13))

plt.plot(maaneder, minimum, marker="o", label="Minimum")
plt.plot(maaneder, median, marker="o", label="Median")
plt.plot(maaneder, maksimum, marker="o", label="Maksimum")

plt.xticks(maaneder)
plt.xlabel("Måned")
plt.ylabel("Vindstyrke (m/s)")
plt.title("Vindstatistikk per måned – Oslo Blindern")
plt.legend()
plt.grid()
plt.tight_layout()
plt.show()